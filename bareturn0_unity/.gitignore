# Unity-specific folders to ignore
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# JetBrains Rider autogenerated plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache and build files
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Gradle and temporary Android files
.gradle/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and system info
sysinfo.txt

# Build outputs
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics files
crashlytics-build.properties

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary Streaming Assets
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# Allow the Packages folder to be tracked
!Packages/manifest.json
!Packages/packages-lock.json

*.DS_Store
